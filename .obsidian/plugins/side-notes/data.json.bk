{
  "sidenoteFormat": "html",
  "hideFootnotes": true,
  "hideFootnoteNumbers": true,
  "sidenotePosition": "left",
  "showSidenoteNumbers": false,
  "numberStyle": "arabic",
  "numberBadgeStyle": "plain",
  "numberColor": "",
  "minSidenoteWidth": 5,
  "maxSidenoteWidth": 10,
  "sidenoteGap": 2,
  "sidenoteGap2": 1,
  "sidenoteGapDrift": 0.3,
  "sidenoteAnchor": "text",
  "pageOffsetFactor": 1,
  "hideBelow": 900,
  "compactBelow": 1000,
  "fullAbove": 1450,
  "fontSize": 80,
  "fontSizeCompact": 70,
  "lineHeight": 1.35,
  "textColor": "",
  "hoverColor": "",
  "textAlignment": "left",
  "collisionSpacing": 8,
  "enableTransitions": true,
  "resetNumberingPerHeading": false,
  "pdfExport": false,
  "marginNoteDisplay": "popup",
  "popupIcon": "ⓘ",
  "marginNoteScaleFactor": 1,
  "popupIconScaleFactor": 1
}