# fecha: 13-july-2026
# v11 — consulta Wolfram Alpha Full API con una expresión seleccionada.
#
# ESTADO ACTUAL (v11):
# ✔ Extrae dinámicamente todos los pods que devuelve WA (sin lista fija)
# ✔ Pods excluidos por título: "Input interpretation", "Image"
# ✔ Descarga PNG del primer pod Plot y lo guarda en _assets/ima-N.png
# ✔ Numeración automática ima-1, ima-2... sin sobreescritura
# ✔ Preprocesador LaTeX→WA: convierte \lim, \frac, \infty, \to antes de mandar a la API
#   (la API no acepta esos comandos directamente aunque la web sí los entiende)
# ✔ Traductor plaintext WA→LaTeX en el output:
#   - Símbolos: != → \neq, -> → \to, infinity → \infty, pi → \pi
#   - Funciones: sin/cos/tan/ln/log → \sin/\cos/\tan/\ln/\log, sqrt() → \sqrt{}
#   - integral → \int (WA devuelve formato integral_0^inf etc, se respeta el resto)
#   - constant → C
#   - Conjuntos: element R → \in \mathbb{R}
# ✘ PENDIENTE: limites en output (lim_(x->0) no se convierte a \lim_{x \to 0})
# ✘ PENDIENTE: fracciones en texto plano por decisión (a/b no se convierte a \dfrac)
#   el usuario corrige manualmente si necesita LaTeX para fracciones
#
# NOTAS IMPORTANTES:
# - El backslash en re.sub replacement: usar r'\comando' (1 backslash en raw string)
#   NO usar r'\\comando' (produce doble backslash en el output)
#   Excepción: cuando se necesita backslash literal en el output usar '\\\\'
# - safe='\\{}^_' en urllib.parse.quote para no codificar caracteres LaTeX
# - expression_display guarda el LaTeX original para mostrarlo en la nota
#   expression es la versión convertida que se manda a WA
#
# Args: argv[1] expression · argv[2] vault_path

import sys
import os
import json
import re
import urllib.request
import urllib.parse

sys.stdout.reconfigure(encoding='utf-8')

APP_ID     = "A3WL4X56LG"
ASSETS_DIR = "_assets"

# Títulos de pods que nunca se muestran
PODS_EXCLUDE_TITLES = {"Input interpretation", "Image"}

expression = sys.argv[1]
vault_path = sys.argv[2]

# --- Preprocesador LaTeX → texto WA (solo casos que la API no acepta) ---
def latex_to_wa(expr):
    expr = expr.replace(r'\infty', 'infinity')
    expr = expr.replace(r'\to', '->')
    expr = re.sub(r'\\frac\{d\^(\w+)\}\{dx\^\1\}', r'd^\1/dx^\1', expr)
    expr = re.sub(r'\\frac\{d\}\{dx\}', 'd/dx', expr)
    expr = re.sub(r'\\lim_\{([^}]+)\}\s*', r'limit ', expr)
    expr = re.sub(r'\\frac\{([^}]+)\}\{([^}]+)\}', r'(\1)/(\2)', expr)
    return expr

# --- Traductor plaintext WA → LaTeX (Cálculo 1) ---
def plaintext_to_latex(text):
    # Símbolos básicos
    text = text.replace('!=', r'\neq ')
    text = text.replace('>=', r'\geq ')
    text = text.replace('<=', r'\leq ')
    text = text.replace('->', r'\to ')
    text = text.replace('infinity', r'\infty')
    text = text.replace('pi', r'\pi')
    # Conjuntos
    text = re.sub(r'element R', r'\\in \\mathbb{R}', text)
    text = re.sub(
        r'\{([^}]+) \\in \\mathbb\{R\} : ([^}]+)\}',
        r'\\{\1 \\in \\mathbb{R} : \2\\}', text
    )
    # Funciones
    text = re.sub(r'sqrt\(([^)]+)\)', r'\\sqrt{\1}', text)
    text = re.sub(r'\bsin\b', r'\\sin', text)
    text = re.sub(r'\bcos\b', r'\\cos', text)
    text = re.sub(r'\btan\b', r'\\tan', text)
    text = re.sub(r'\bln\b',  r'\\ln',  text)
    text = re.sub(r'\blog\b', r'\\log', text)
    # Cálculo
    text = re.sub(r'integral', r'\\int', text)
    # lim_(x->a) → \lim_{x->a} (formato que devuelve WA en output)
    text = re.sub(r'lim_\(([^)]+)\)', lambda m: r'\lim_{' + m.group(1) + '}', text)
    # limit ... as x->a (formato generado por el preprocesador, por si acaso)
    text = re.sub(
        r'limit\s+(.+?)\s+as\s+([a-z])\s*->\s*([^\s|]+)',
        r'\\lim_{\2 \\to \3} \1', text
    )
    text = text.replace('constant', 'C')
    return text

expression_display = expression
expression = latex_to_wa(expression)

# --- Llamada a WA Full API ---
encoded = urllib.parse.quote(expression, safe='\\{}^_')
url = f"https://api.wolframalpha.com/v2/query?input={encoded}&appid={APP_ID}&output=json"

try:
    with urllib.request.urlopen(url, timeout=10) as r:
        data = json.loads(r.read().decode('utf-8'))
except Exception as e:
    print(f"[ERROR] No se pudo conectar con Wolfram Alpha: {e}")
    sys.exit(1)

if not data.get("queryresult", {}).get("success"):
    print("[ERROR] Wolfram Alpha no pudo interpretar la expresión.")
    sys.exit(1)

pods = data["queryresult"].get("pods", [])

# --- Buscar URL de gráfica (primer pod con imagen en cualquier Plot) ---
plot_url = None
for pod in pods:
    pid = pod.get("id", "")
    if "Plot" in pid or "plot" in pid.lower():
        for sp in pod.get("subpods", []):
            src = sp.get("img", {}).get("src")
            if src:
                plot_url = src
                break
    if plot_url:
        break

# --- Descargar y guardar imagen ---
image_block = ""

if plot_url:
    assets_path = os.path.join(vault_path, ASSETS_DIR)
    os.makedirs(assets_path, exist_ok=True)

    existing = [
        f for f in os.listdir(assets_path)
        if re.match(r'^ima-\d+\.png$', f)
    ]
    numbers = [int(re.search(r'\d+', f).group()) for f in existing]
    next_n  = max(numbers) + 1 if numbers else 1
    img_name = f"ima-{next_n}.png"
    img_path = os.path.join(assets_path, img_name)

    try:
        urllib.request.urlretrieve(plot_url, img_path)
        image_block = f"**Gráfica:**\n![[{img_name}]]"
    except Exception as e:
        image_block = f"**Gráfica:** *(error al descargar: {e})*"

# --- Extraer pods de texto (dinámico) ---
lines = []

if image_block:
    lines.append(image_block)

for pod in pods:
    pod_title = pod.get("title", "")
    pod_id    = pod.get("id", "")
    if pod_title in PODS_EXCLUDE_TITLES:
        continue
    if "Plot" in pod_id or "plot" in pod_id.lower():
        continue
    label   = pod.get("title", pod_id)
    subpods = pod.get("subpods", [])
    texts   = [s["plaintext"] for s in subpods if s.get("plaintext", "").strip()]
    if not texts:
        continue
    content = "\n".join(texts)
    content = plaintext_to_latex(content)
    # Cada línea en su propio bloque $$
    content_lines = content.split("\n")
    block = "\n".join(f"$${l.strip()}$$" for l in content_lines if l.strip())
    lines.append(f"**{label}:**\n{block}")

# --- Construir output para la nota ---
body = "\n\n".join(lines)

output = f"""
**WolframAlpha:** ${expression_display}$

{body}

```
Resolvé paso a paso sin ejercicio adicional (MODO 3):
{expression_display}
Si aplica, graficá usando Desmos o TikZJax.
```
"""

print(output)
