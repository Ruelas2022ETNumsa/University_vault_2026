/* =============================
   GALAXY BODY
   ============================= */
.nav-file-title-content[data-link-galaxy_body="star"]::before { content: "☀️ "; }
.nav-file-title-content[data-link-galaxy_body="planet"]::before { content: "🪐 "; }
.nav-file-title-content[data-link-galaxy_body="moon"]::before { content: "🌙 "; }
.nav-file-title-content[data-link-galaxy_body="comet"]::before { content: "☄️ "; }
.nav-file-title-content[data-link-galaxy_body="nebula"]::before { content: "🌫️ "; }
.nav-file-title-content[data-link-galaxy_body="dwarf"]::before { content: "⬛ "; }
.nav-file-title-content[data-link-galaxy_body="asteroid"]::before { content: "🪨 "; }
.nav-file-title-content[data-link-galaxy_body="photon"]::before { content: "💡 "; }
.nav-file-title-content[data-link-galaxy_body="neutrino"]::before { content: "⚛️ "; }
.nav-file-title-content[data-link-galaxy_body="constellation"]::before { content: "🌌 "; }
.nav-file-title-content[data-link-galaxy_body="observatory"]::before { content: "🔭 "; }
.nav-file-title-content[data-link-galaxy_body="bridge"]::before { content: "🌉 "; }
.nav-file-title-content[data-link-galaxy_body="beacon"]::before { content: "📡 "; }
.nav-file-title-content[data-link-galaxy_body="supernova"]::before { content: "✨ "; }
.nav-file-title-content[data-link-galaxy_body="workshop"]::before { content: "🔧 "; }

/* =============================
   TASK STATUS
   ============================= */
.nav-file-title-content[data-link-status="nueva"]::before {content: "🌑 ";}
.nav-file-title-content[data-link-status="creciente"]::before {content: "🌒 ";}
.nav-file-title-content[data-link-status="llena"]::before {content: "🌕 ";}

/* =============================
   OPERATOR STATUS
   ============================= */
.nav-file-title-content[data-link-status="free"]::before  { content: "✔ "; }
.nav-file-title-content[data-link-status="busy"]::before  { content: "❌ "; }

/* =============================
   SHIP / CARRIER STATUS
   (selectores simples — fallback para archivos sin galaxy_body)
   ============================= */
.nav-file-title-content[data-link-status="docked"]::before    { content: "🛸 "; }
.nav-file-title-content[data-link-status="in-orbit"]::before  { content: "💫 "; }
.nav-file-title-content[data-link-status="delayed"]::before   { content: "⏸️ "; }
.nav-file-title-content[data-link-status="docking"]::before   { content: "⚙️ "; }
.nav-file-title-content[data-link-status="aborted"]::before   { content: "💀 "; }
.nav-file-title-content[data-link-status="delivered"]::before { content: "✅ "; }

/* =============================
   SHIP — combinado (body + status)
   ::before = galaxy_body | ::after = status
   ============================= */
.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="docked"]::before    { content: "🚀 "; }
.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="docked"]::after     { content: " 🛸"; }

.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="in-orbit"]::before  { content: "🚀 "; }
.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="in-orbit"]::after   { content: " 💫"; }

.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="delayed"]::before   { content: "🚀 "; }
.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="delayed"]::after    { content: " ⏸️"; }

.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="docking"]::before   { content: "🚀 "; }
.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="docking"]::after    { content: " ⚙️"; }

.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="aborted"]::before   { content: "🚀 "; }
.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="aborted"]::after    { content: " 💀"; }

.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="delivered"]::before { content: "🚀 "; }
.nav-file-title-content[data-link-galaxy_body="ship"][data-link-status="delivered"]::after  { content: " ✅"; }

/* =============================
   CARRIER — combinado (body + status)
   ::before = galaxy_body | ::after = status
   ============================= */
.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="docked"]::before    { content: "🛸 "; }
.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="docked"]::after     { content: " 🛸"; }

.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="in-orbit"]::before  { content: "🛸 "; }
.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="in-orbit"]::after   { content: " 💫"; }

.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="delayed"]::before   { content: "🛸 "; }
.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="delayed"]::after    { content: " ⏸️"; }

.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="docking"]::before   { content: "🛸 "; }
.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="docking"]::after    { content: " ⚙️"; }

.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="aborted"]::before   { content: "🛸 "; }
.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="aborted"]::after    { content: " 💀"; }

.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="delivered"]::before { content: "🛸 "; }
.nav-file-title-content[data-link-galaxy_body="carrier"][data-link-status="delivered"]::after  { content: " ✅"; }

/* =============================
   BLUEPRINT STATUS
   ============================= */
.nav-file-title-content[data-link-status="idea"]::before      { content: "💡 "; }
.nav-file-title-content[data-link-status="evaluando"]::before { content: "🔍 "; }
.nav-file-title-content[data-link-status="aprobado"]::before  { content: "📐 "; }

/* =============================
   GALAXY BODY — PROYECTOS (subtipo)
   ============================= */
.nav-file-title-content[data-link-galaxy_body="operator"]::before  { content: "🧑✈️ "; }
.nav-file-title-content[data-link-galaxy_body="ship"]::before      { content: "🚀 "; }
.nav-file-title-content[data-link-galaxy_body="carrier"]::before   { content: "🛸 "; }
.nav-file-title-content[data-link-galaxy_body="dropship"]::before  { content: "🛩️ "; }
.nav-file-title-content[data-link-galaxy_body="logbook"]::before   { content: "📋 "; }
.nav-file-title-content[data-link-galaxy_body="blueprint"]::before { content: "📐 "; }
.nav-file-title-content[data-link-galaxy_body="void"]::before      { content: "🌑 "; }



