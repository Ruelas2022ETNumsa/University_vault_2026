EXPORT VOL_CALC()
BEGIN
  LOCAL op, r, h, a, b, c, v;

  CHOOSE(op, "Volumenes",
    "Esfera",
    "Cilindro",
    "Cono",
    "Cubo",
    "Paralelepipedo",
    "Piramide rect."
  );

  IF op == 1 THEN
    INPUT(r, "Esfera", "r:", "Radio:", 1);
    v := (4/3) * pi * r^3;
    MSGBOX("Esfera\nV = " + v);
    RETURN v;
  END;

  IF op == 2 THEN
    INPUT(r, "Cilindro", "r:", "Radio:", 1);
    INPUT(h, "Cilindro", "h:", "Altura:", 1);
    v := pi * r^2 * h;
    MSGBOX("Cilindro\nV = " + v);
    RETURN v;
  END;

  IF op == 3 THEN
    INPUT(r, "Cono", "r:", "Radio base:", 1);
    INPUT(h, "Cono", "h:", "Altura:", 1);
    v := (1/3) * pi * r^2 * h;
    MSGBOX("Cono\nV = " + v);
    RETURN v;
  END;

  IF op == 4 THEN
    INPUT(a, "Cubo", "a:", "Lado:", 1);
    v := a^3;
    MSGBOX("Cubo\nV = " + v);
    RETURN v;
  END;

  IF op == 5 THEN
    INPUT(a, "Paralelepipedo", "a:", "Largo:", 1);
    INPUT(b, "Paralelepipedo", "b:", "Ancho:", 1);
    INPUT(c, "Paralelepipedo", "c:", "Alto:", 1);
    v := a * b * c;
    MSGBOX("Paralelepipedo\nV = " + v);
    RETURN v;
  END;

  IF op == 6 THEN
    INPUT(a, "Piramide", "a:", "Base largo:", 1);
    INPUT(b, "Piramide", "b:", "Base ancho:", 1);
    INPUT(h, "Piramide", "h:", "Altura:", 1);
    v := (1/3) * a * b * h;
    MSGBOX("Piramide rect.\nV = " + v);
    RETURN v;
  END;

END;