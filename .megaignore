# ============================================================
# .megaignore — Universidad vault 2026
# PROHIBIDO editar o sobreescribir por Claude
# salvo que el usuario lo pida explícitamente.
# ============================================================

# Archivos basura de Windows
-:Thumbs.db
-:desktop.ini

# Archivos temporales y en proceso de descarga
-:~*
-:*~.*
-:*.crdownload
-:*.sb-????????-??????
-:*.tmp

# Repositorio Git — no debe tocar Mega
-:.git

# Cache de Obsidian — se regenera en cada dispositivo
# (SVGs de Desmos y similares no viajan: rutas internas incompatibles)
-:.cache

# Archivos del sistema de sync — cada dispositivo mantiene los suyos
-:.gitignore
-:.gitattributes
-:.megaignore

# Obsidian — solo estos 3 generan conflicto entre dispositivos
# (estado de UI: paneles abiertos, posición, grafo visual)
# Todo lo demás de .obsidian SÍ se sincroniza (plugins, snippets, hotkeys, themes)
-:workspace.json
-:workspace-mobile.json
-:graph.json